<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        android:title="@string/livestream_alerts"
        app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="live_notifications_enabled"
        android:summary="@string/live_notifications_summary"
        android:title="@string/live_notifications"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:dependency="live_notifications_enabled"
        android:key="live_notifications_polling_backup"
        android:summary="@string/live_notifications_polling_backup_summary"
        android:title="@string/live_notifications_polling_backup"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <PreferenceCategory
        android:title="@string/daily_rewards_category"
        app:iconSpaceReserved="false" />

    <SwitchPreferenceCompat
        android:defaultValue="true"
        android:key="kick_daily_rewards_enabled"
        android:summary="@string/kick_daily_rewards_enabled_summary"
        android:title="@string/kick_daily_rewards_enabled_title"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:dependency="kick_daily_rewards_enabled"
        android:key="reward_auto_claim_enabled"
        android:summary="@string/reward_auto_claim_summary"
        android:title="@string/reward_auto_claim"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <SwitchPreferenceCompat
        android:defaultValue="true"
        android:dependency="reward_auto_claim_enabled"
        android:key="reward_claim_notifications_enabled"
        android:title="@string/reward_claim_notifications"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

</androidx.preference.PreferenceScreen>
