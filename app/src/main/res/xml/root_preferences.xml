<androidx.preference.PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Preference
        android:key="nav_api_token_settings"
        android:title="@string/account"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="nav_appearance_settings"
        android:title="@string/appearance"
        android:summary="@string/nav_appearance_summary"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="nav_player_overview"
        android:title="@string/video_and_audio"
        android:summary="@string/nav_video_audio_summary"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="nav_chat_settings"
        android:title="@string/chat_settings"
        android:summary="@string/nav_chat_summary"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="nav_notifications_settings"
        android:title="@string/notifications_and_rewards"
        android:summary="@string/nav_notifications_summary"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="nav_download_settings"
        android:title="@string/download_settings"
        android:summary="@string/nav_download_settings_summary"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

    <Preference
        android:key="nav_advanced_settings"
        android:title="@string/system_and_advanced"
        android:summary="@string/nav_system_summary"
        app:iconSpaceReserved="false"
        app:singleLineTitle="false" />

</androidx.preference.PreferenceScreen>
